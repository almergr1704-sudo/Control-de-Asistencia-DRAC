{
  "name": "drac-control-asistencia",
  "private": true,
  "version": "1.0.0",
  "description": "Sistema Institucional de Control de Asistencia - DRAC Cajamarca",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs --external:vite --external:@vitejs/plugin-react --external:@tailwindcss/vite --external:fsevents",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs --external:vite --external:@vitejs/plugin-react --external:@tailwindcss/vite --external:fsevents",
    "build:desktop": "npm run build && node scripts/prepare-build.cjs && electron-builder --win nsis portable zip",
    "lint": "vite build --mode development",
    "start": "tsx server.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "tsx": "^4.19.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "cross-env": "^10.1.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2"
  }
}